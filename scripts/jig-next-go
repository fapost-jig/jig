#!/usr/bin/env bash
# jig-next-go — build and run the Go implementation of the next Jig (next/go).
#
#   scripts/jig-next-go [--version | --help]
#
# Builds next/go/cmd/jig-next into .ai/runtime/jig-next-go/, which git already
# ignores, unless the binary there is newer than every Go source, go.mod and go.sum
# of the module (a repeat run then starts no build at all), and runs it with the
# arguments given. The program has no commands yet beyond --version and --help;
# it grows beside the bash implementation and calls nothing of it.
#
# The framework checkout the program belongs to is this script's, and it is
# passed in JIG_NEXT_ROOT: the program reads the version from there, as
# `jig --version` does.
#
# JIG_NEXT_BUILD_DIR   where the binary is built (default .ai/runtime/jig-next-go); a test
#                      sets it so that two runs never build into one file.
set -eu
set -o pipefail

die() {
  printf 'jig-next-go: error: %s\n' "$*" >&2
  exit 1
}

command -v go >/dev/null 2>&1 || die "go is not installed"

here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd) || die "cannot find the script's directory"
root=$(cd -P "$here/.." && pwd) || die "cannot find the repository"
module="$root/next/go"
[ -f "$module/go.mod" ] || die "no Go module at $module"

out="${JIG_NEXT_BUILD_DIR:-$root/.ai/runtime/jig-next-go}"
mkdir -p "$out" || die "cannot make $out"

# Built only when it is out of date: the binary is missing, or a Go source, go.mod or go.sum
# of the module is newer than it. One find, whose first hit is enough (BSD and GNU alike).
bin="$out/jig-next"
rebuild=1
if [ -x "$bin" ]; then
  newer=$(cd "$module" && find . \( -name '*.go' -o -name go.mod -o -name go.sum \) -newer "$bin" -print 2>/dev/null | head -n 1) || newer=""
  [ -z "$newer" ] && rebuild=0
fi
if [ "$rebuild" -eq 1 ]; then
  (cd "$module" && CGO_ENABLED=0 go build -o "$bin" ./cmd/jig-next) || die "go build failed"
fi

JIG_NEXT_ROOT="$root"
export JIG_NEXT_ROOT
exec "$out/jig-next" "$@"
